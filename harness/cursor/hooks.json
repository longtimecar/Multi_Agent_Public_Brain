{
    "version":  1,
    "hooks":  {
                  "sessionStart":  [
                                       {
                                           "command":  "\"<PROJECT>/.venv/Scripts/python.exe\" \"<PROJECT>/scripts/harness_hook.py\" cursor session-start",
                                           "timeout":  30
                                       }
                                   ],
                  "sessionEnd":  [
                                     {
                                         "command":  "\"<PROJECT>/.venv/Scripts/python.exe\" \"<PROJECT>/scripts/harness_hook.py\" cursor capture",
                                         "timeout":  30
                                     }
                                 ],
                  "beforeSubmitPrompt":  [
                                             {
                                                 "command":  "\"<PROJECT>/.venv/Scripts/python.exe\" \"<PROJECT>/scripts/harness_hook.py\" cursor prompt-submit",
                                                 "timeout":  30
                                             }
                                         ],
                  "preCompact":  [
                                     {
                                         "command":  "\"<PROJECT>/.venv/Scripts/python.exe\" \"<PROJECT>/scripts/harness_hook.py\" cursor precompact",
                                         "timeout":  30
                                     }
                                 ],
                  "stop":  [
                               {
                                   "command":  "\"<PROJECT>/.venv/Scripts/python.exe\" \"<PROJECT>/scripts/harness_hook.py\" cursor capture",
                                   "timeout":  30
                               }
                           ]
              }
}