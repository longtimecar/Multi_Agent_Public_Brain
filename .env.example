# membrain credentials.
# Copy this file to .env and fill it in. .env is gitignored, so keys stay out of
# the repo and out of chat logs. Real environment variables override values here.
# Empty values count as unset. Never put real keys in this template file.

# --- Embeddings: search by meaning (used now) --------------------------------
# Any service that accepts OpenAI-style POST requests to /embeddings.
# The base URL may end with /v1 or with /v1/embeddings; both work.
# Pick a multilingual model, since memories mix Chinese and English
# (for example text-embedding-3-small, bge-m3, Qwen3-Embedding).
# Leave the model empty to use text-embedding-3-small.
# After setting or changing the model, run: uv run membrain reindex
MEMBRAIN_EMBED_BASE_URL=
MEMBRAIN_EMBED_API_KEY=
MEMBRAIN_EMBED_MODEL=

# --- LLM: background fact extraction ----------------------------------------
# MEMBRAIN_LLM_API_FORMAT is openai or anthropic.
#   openai:    base URL usually ends in /v1 (requests go to /chat/completions)
#   anthropic: base URL without /v1, like ANTHROPIC_BASE_URL (requests go to /v1/messages)
MEMBRAIN_LLM_BASE_URL=
MEMBRAIN_LLM_API_KEY=
MEMBRAIN_LLM_MODEL=
MEMBRAIN_LLM_API_FORMAT=openai

# --- Optional tuning (defaults shown) -----------------------------------------
# MEMBRAIN_TURN_TOKEN_BUDGET=1500
# MEMBRAIN_SESSION_TOKEN_BUDGET=2500
# MEMBRAIN_EMBED_TIMEOUT=20
# MEMBRAIN_LLM_TIMEOUT=30
# Similarity selects possible duplicate candidates; the LLM makes the final
# comparison because contradictory claims can have very similar vectors.
# MEMBRAIN_DUPLICATE_FLOOR=0.70
# Query instructions are applied only to searches, not stored facts. Qwen3
# models use its retrieval instruction by default; other models use none.
# MEMBRAIN_EMBED_QUERY_INSTRUCTION=Given a user query, retrieve relevant personal facts
# Default calibrated for the configured Qwen3 model; recalibrate after changing
# the model or instruction. A single floor cannot eliminate every false match.
# MEMBRAIN_SEMANTIC_FLOOR=0.41

# --- Optional OpenViking history import --------------------------------------
# Leave unset to disable the legacy import card. Set it to the OpenViking user
# folder (the directory that contains scope folders with a memories/ child).
# MEMBRAIN_OPENVIKING_ROOT=

# --- P2 gaps 9/10/13 (defaults keep SessionStart fast) ---
# MEMBRAIN_EVOLUTION=0
# MEMBRAIN_SKILLS_INJECT=1
# MEMBRAIN_USE_RERANK=0
# MEMBRAIN_RERANK_PROVIDER=heuristic
# MEMBRAIN_RERANK_BASE_URL=
# MEMBRAIN_RERANK_API_KEY=
# MEMBRAIN_RERANK_MODEL=
# MEMBRAIN_RERANK_TIMEOUT=20

# --- Time, capture and session summaries -------------------------------------
# Which calendar "昨晚" is resolved against, and which day a captured turn is
# filed under. An IANA name; unset means the system default. Set this if the
# machine's timezone is not the one you think in.
# MEMBRAIN_TZ=Asia/Shanghai

# Auto-capture watcher. Runs inside the dashboard, or on its own via
# `membrain watch` (install at login with `membrain autostart`).
# MEMBRAIN_WATCH=1
# MEMBRAIN_WATCH_INTERVAL=300

# Session summaries (memory/summaries/*.md) — a derived view, never evidence.
# MEMBRAIN_CONSOLIDATE=1
# MEMBRAIN_CONSOLIDATE_IDLE_MINUTES=60
